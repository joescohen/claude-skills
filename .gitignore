# Only track explicitly added skills — ignore everything else by default
*
!.gitignore
# Project design docs / specs
!docs/
!docs/**
!best-finder/
!best-finder/**
best-finder/dist/
!ei-validate/
!ei-validate/**
!ei-skill-auditor/
!ei-skill-auditor/**
!ei-chat-triage/
!ei-chat-triage/**
!ei-recursive-goal/
!ei-recursive-goal/**
!ei-research/
!ei-research/**
!ei-audit-project/
!ei-audit-project/**
!ei-loop/
!ei-loop/**
__pycache__/
# improve/ and verification-lanes/ are not tracked here, but their Codex explicit-only
# policy file is, so the guard is under version control. Directories only, one file each.
!improve/
!improve/agents/
!improve/agents/openai.yaml
!verification-lanes/
!verification-lanes/agents/
!verification-lanes/agents/openai.yaml
